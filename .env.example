NEXT_PUBLIC_APP_NAME=GreedyGoose
NEXT_PUBLIC_APP_LOGO_URL=
NEXT_PUBLIC_JAW_API_KEY=
NEXT_PUBLIC_ENS_PARENT=justan.id
NEXT_PUBLIC_BASE_RPC_URL=
# Ethereum mainnet, for the account's name (ENS and JAW's subnames). Empty uses viem's public mainnet RPC.
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_ELIGIBILITY_MODE=geo+attest

# Agents (D14): GooseExecutor, the spender of every agent permission. Leave empty until it is audited and deployed;
# never a D13 test deploy in production config. The D13 test deploy (0x778d…A71b) still runs the rules from before
# "Act is the line" (repays in Watch below 1.50, Weekend Shield), while the app's words follow the next deploy's.
NEXT_PUBLIC_GOOSE_EXECUTOR=
# 1 once Chainlink has approved the agents' automation: until then the Agents tab says "Coming soon".
NEXT_PUBLIC_AGENTS_LIVE=

# Guardian's keeper (feat/guardian). Leave empty until the checker is audited and deployed. The app reads neither.
NEXT_PUBLIC_GUARDIAN_CHECKER=
# Keeper server only — never NEXT_PUBLIC:
GUARDIAN_KEEPER_KEY=
BASE_RPC_URL=
GUARDIAN_FROM_BLOCK=

# The Leaderboard (formerly Friends): GooseBoard, the member list (contracts/docs/DEPLOYMENTS.md). Empty until Adrian
# deploys it: the tab then says "The leaderboard opens soon." and no move carries join(). The board reads its logs from
# NEXT_PUBLIC_BASE_RPC_URL; without it, from PublicNode's keyless endpoint, which only serves about the last 10,000 blocks.
NEXT_PUBLIC_GOOSE_BOARD=
# "off" hides the Leaderboard tab and makes /leaderboard a 404 (NEXT_PUBLIC_FRIENDS=off still does too).
NEXT_PUBLIC_LEADERBOARD=on
