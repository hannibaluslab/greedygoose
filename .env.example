NEXT_PUBLIC_APP_NAME=GreedyGoose
NEXT_PUBLIC_APP_LOGO_URL=
NEXT_PUBLIC_JAW_API_KEY=
NEXT_PUBLIC_ENS_PARENT=justan.id
NEXT_PUBLIC_BASE_RPC_URL=
# Ethereum mainnet, for the account's name (ENS and JAW's subnames). Empty uses viem's public mainnet RPC.
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_ELIGIBILITY_MODE=geo+attest
# Optional. Alchemy's Transfers API: money and stocks someone else sent, in Activity and the Cash sheet, and Home's
# all-time line. Base's public RPC refuses getLogs, so these stay off without it. It ships in the page, so allow it only
# from the app's domains in Alchemy's dashboard (lib/activity/alchemy.ts).
NEXT_PUBLIC_ALCHEMY_KEY=

# Agents: GooseExecutor, the spender of every agent permission, and the block it was deployed in (the agents' history is
# read from there). Production uses 0x686cd88F248DE3F9FC0835566DB798D93881F02D from block 52851406: no amount cap, not
# audited yet (contracts/docs/DEPLOYMENTS.md, "Live now"). Left empty here, a local build shows the agents as "Coming
# soon" and can't grant anything by accident. Never use the old D13 test deploy (0x778d…A71b): it runs retired rules.
NEXT_PUBLIC_GOOSE_EXECUTOR=
NEXT_PUBLIC_GOOSE_EXECUTOR_BLOCK=
# 1 once the executor above is set and its runner is on. Production: 1. Empty: the Agents tab says "Coming soon".
NEXT_PUBLIC_AGENTS_LIVE=

# The Leaderboard (formerly Friends): GooseBoard, the member list, live at 0x0E10c55D3f20D4Ea1DEf5aC6c60480b34c07FcA1
# (contracts/docs/DEPLOYMENTS.md). Empty: the tab says "The leaderboard opens soon." and no move carries join(). The board
# reads its logs from NEXT_PUBLIC_BASE_RPC_URL, which must serve the board's whole log history: a free PublicNode personal
# token (allnodes.com) does; PublicNode's keyless endpoint only serves about the last 10,000 blocks.
NEXT_PUBLIC_GOOSE_BOARD=
# Greedy Fatalities, the Wall of shame (lib/board/wall.ts): only stock sold after this block puts anyone on it.
# Production: 52912478, kept the same on every deploy so the Wall's count never restarts. Empty: no Wall, and credit
# stays capped at 1.12.
NEXT_PUBLIC_WALL_FROM_BLOCK=
# "off" hides the Leaderboard tab and makes /leaderboard a 404 (NEXT_PUBLIC_FRIENDS=off still does too).
NEXT_PUBLIC_LEADERBOARD=on

# Dev only, never shipped: hosts other than localhost that may open `npm run dev` (a phone on the LAN, a VM's IP),
# comma-separated.
DEV_ALLOWED_ORIGINS=
